# Configurações do Telegram
TELEGRAM_BOT_TOKEN=9224474540:AAFpGj8sBzPUTShYXMOSnu9Bg03TzFR2UUs

# IDs autorizados do Telegram (separados por vírgula, ex: 12345678,87654321)
# Se deixar vazio, o primeiro usuário a mandar /start será registrado como admin
ALLOWED_TELEGRAM_IDS=

# Chave da API do Google Gemini (obtenha em: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Fuso horário para os lembretes (ex: America/Sao_Paulo)
TIMEZONE=America/Sao_Paulo

# Porta do servidor de healthcheck para Render (padrão: 8080)
PORT=8080

# Banco de dados:
# Para SQLite local (padrão): sqlite+aiosqlite:///data/liam.db
# Para Supabase (PostgreSQL na nuvem):
# Cole a Connection String do Supabase (URI) diretamente, exemplo:
# DATABASE_URL=postgresql://postgres.seuid:suasenha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///data/liam.db
